# Comma-separated list of OpenAI-compatible backend base URLs (SGLang/vLLM instances).
# Each entry should NOT include a trailing slash or the /v1/... path segment.
IMPACTROUTER_BACKENDS=http://localhost:30000,http://localhost:30001

# Routing mode: "affinity" (sibling-aware routing) or "round_robin" (naive control).
# This is the toggle the FM-1 benchmark flips between runs -- do not hardcode it.
IMPACTROUTER_MODE=affinity

# Port the ImpactRouter proxy itself listens on.
IMPACTROUTER_PORT=8000

# How often (seconds) each backend's /health endpoint is polled and cached.
IMPACTROUTER_HEALTH_CHECK_INTERVAL_S=5.0

# Path/name of the backend health endpoint, appended to each backend base URL.
IMPACTROUTER_HEALTH_PATH=/health

# Path to the JSONL request log.
IMPACTROUTER_LOG_PATH=logs/impactrouter_requests.jsonl

# Timeout (seconds) for the whole outbound request to a backend.
IMPACTROUTER_BACKEND_TIMEOUT_S=120.0
